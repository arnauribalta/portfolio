---
import TwoTone from "./TwoTone.astro";
import HeroPortrait from "./HeroPortrait.astro";
import { site } from "../lib/content";
import { t, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { hero, person } = site;
---

<section id="inicio" class="section hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__name"><TwoTone parts={person.displayName} /></h1>
      <p class="hero__subtitle">{t(hero.subtitle, lang)}</p>
      {
        hero.status.visible && (
          <p class="hero__status">
            <span class="hero__dot" aria-hidden="true" />
            {t(hero.status.text, lang)}
          </p>
        )
      }
    </div>
    <div class="hero__portrait">
      <HeroPortrait lang={lang} />
    </div>
  </div>

  <a class="hero__hint" href="#sobre-mi">
    <span>{t(hero.scrollHint, lang)}</span>
    <span class="hero__line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    align-items: center;
    gap: 48px;
  }

  .hero__name {
    font-size: clamp(3rem, 6.4vw, 6rem);
    line-height: 1;
    letter-spacing: .01em;
  }

  .hero__subtitle {
    margin-top: 18px;
    font-style: italic;
    font-size: clamp(.875rem, 1.1vw, 1.0625rem);
    line-height: 1.5;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .hero__dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--status);
  }

  .hero__dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--status);
    animation: pulse 2.4s var(--ease) infinite;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: .6; }
    80%, 100% { transform: scale(2.6); opacity: 0; }
  }

  .hero__hint {
    position: absolute;
    bottom: 32px;
    left: max(var(--gutter), (100% - var(--container)) / 2);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-faint);
  }

  .hero__hint:hover {
    color: var(--text-title);
  }

  .hero__line {
    position: relative;
    width: 40px;
    height: 1px;
    overflow: hidden;
    background: var(--line);
  }

  .hero__line::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--text-title);
    transform: translateX(-100%);
    animation: line-fill 2.2s var(--ease) infinite;
  }

  @keyframes line-fill {
    0% { transform: translateX(-100%); }
    50% { transform: translateX(0); }
    100% { transform: translateX(100%); }
  }

  @media (max-width: 767px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 24px;
      justify-items: center;
      text-align: center;
    }

    .hero__portrait {
      order: -1;
      width: min(280px, 100%);
    }

    .hero__subtitle {
      letter-spacing: .14em;
    }

    .hero__hint {
      left: 50%;
      transform: translateX(-50%);
      bottom: 16px;
    }
  }
</style>
