---
// Imagen optimizada: <Picture> en AVIF/WebP con anchos 400/800/1200/1600.
// Los SVG se sirven tal cual.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { isSvg, widthsFor } from "../lib/images";

interface Props {
  image: ImageMetadata;
  alt: string;
  sizes: string;
  class?: string;
  priority?: boolean;
}

const { image, alt, sizes, class: className, priority = false } = Astro.props;
---

{
  isSvg(image) ? (
    <img
      src={image.src}
      width={image.width}
      height={image.height}
      alt={alt}
      class={className}
      loading={priority ? "eager" : "lazy"}
      decoding="async"
    />
  ) : (
    <Picture
      src={image}
      alt={alt}
      formats={["avif", "webp"]}
      widths={widthsFor(image)}
      sizes={sizes}
      class={className}
      loading={priority ? "eager" : "lazy"}
      decoding={priority ? "sync" : "async"}
      fetchpriority={priority ? "high" : "auto"}
    />
  )
}
