---
// Portada animada: grafo neuronal estilo Obsidian. Decorativo; lo dibuja src/scripts/neural-graph.ts.
---

<div class="ngraph" aria-hidden="true">
  <canvas data-neural-graph></canvas>
</div>

<style>
  .ngraph {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 20%, rgba(255, 255, 255, .05), transparent 60%),
      var(--surface-3);
    border: 1px solid var(--line-soft);
    border-radius: inherit;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import "../scripts/neural-graph";
</script>
